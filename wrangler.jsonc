{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "longride",
  "compatibility_date": "2026-08-13",
  "workers_dev": true,
  // A custom domain, not a route pattern: Cloudflare creates and manages the
  // DNS record for this hostname itself, so there is no separate CNAME to keep
  // in step. Scoped to a subdomain on purpose - the apex is left alone.
  "routes": [
    {
      "pattern": "longride.maheshpalavalli.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
