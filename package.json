{
  "name": "windhoof",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "packageManager": "pnpm@11.16.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "deploy": "pnpm build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:generation": "vitest run tests/generation",
    "test:first-island": "vitest run tests/generation/firstIslandCompiler.test.ts tests/generation/firstIslandTraversal.test.ts tests/simulation/firstIslandProgression.test.ts tests/save/firstIslandSave.test.ts tests/app/webglRecovery.test.ts",
    "test:watch": "vitest",
    "test:browser": "playwright test",
    "inspect": "node tools/inspectHorseLab.mjs",
    "lint": "eslint .",
    "inspect:island": "node tools/inspectIsland.mjs",
    "inspect:island:spots": "node tools/inspectIsland.mjs --spots",
    "profile:island": "node tools/profileIsland.mjs",
    "journey:walkthrough": "node tools/journeyWalkthrough.mjs",
    "island:capture": "node tools/captureFirstIsland.mjs",
    "island:journey": "node tools/journeyFirstIsland.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.62.1",
    "@types/node": "24.13.3",
    "@types/three": "0.185.4",
    "eslint": "10.8.1",
    "globals": "17.11.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.1",
    "vitest": "4.1.10",
    "wrangler": "4.122.0"
  }
}
